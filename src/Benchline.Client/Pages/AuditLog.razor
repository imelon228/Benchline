@using Microsoft.AspNetCore.Components.Web.Virtualization
<div class="section-title">
    <div><h1>Audit log</h1><p>Workshop changes in reverse chronological order.</p></div>
    @if (Online)
    {
        <a href="api/audit.csv" class="primary-button" download>Export CSV</a>
    }
    else
    {
        <div>
            <button class="primary-button" disabled aria-describedby="export-reason">Export CSV</button>
            <small class="action-reason" id="export-reason">Reconnect to download the audit history</small>
        </div>
    }
</div>
<section aria-label="Audit history">
    @if (Loading)
    {
        <p role="status">Loading audit entries…</p>
    }
    @if (Rows.Length == 0 && !Loading)
    {
        <p class="empty">No changes have been recorded yet. Return to the board to check the schedule.</p>
    }
    else if (Rows.Length > 0)
    {
        <div class="audit-scroll" role="region" aria-label="Audit entries" tabindex="0">
            <ul class="item-stack">
                <Virtualize Items="Rows" Context="row" SpacerElement="li" ItemSize="44">
                    <li @key="row.Revision">
                        <div class="stack-copy"><strong>@row.Event</strong><span class="audit-details mono">@row.Details</span></div>
                        <span class="audit-date">@WorkshopFormat.Time(row.RecordedAt), @ActorName(row.ActorId)</span>
                    </li>
                </Virtualize>
            </ul>
        </div>
    }
    @if (NextCursor is not null)
    {
        <button class="secondary-button" disabled="@(Loading || !Online)" aria-describedby="@(Loading || !Online ? "older-reason" : null)"
                @onclick="() => LoadOlder.InvokeAsync(NextCursor.Value)">Load older entries</button>
        @if (Loading || !Online)
        {
            <small class="action-reason" id="older-reason">@(Online ? "Loading audit entries" : "Reconnect to load more entries")</small>
        }
    }
</section>

@code {
    [Parameter] public AuditDto[] Rows { get; set; } = [];
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Online { get; set; }
    [Parameter] public bool Demo { get; set; }
    [Parameter] public long? NextCursor { get; set; }
    [Parameter] public EventCallback<long> LoadOlder { get; set; }

    private string ActorName(string id) => Demo ? DemoCatalog.DisplayName(id) ?? id : id;
}
